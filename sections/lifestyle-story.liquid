{% comment %}
  Section: Lifestyle Story
  Emotional "image + text" section placed after the product form.
  Tells the story of the cardigan, builds desire, and leads into features.
{% endcomment %}

<section class="lifestyle-section" id="lifestyle-story" aria-labelledby="lifestyle-heading">

  <div class="lifestyle-inner">

    <!-- Left: Large atmospheric image -->
    <div class="lifestyle-image reveal">
      {%- if section.settings.image != blank -%}
        {{- section.settings.image | image_url: width: 900 | image_tag:
            loading: 'lazy',
            alt: section.settings.image_alt | default: 'Solea Shell Stitch Cardigan worn outdoors' -}}
      {%- else -%}
        <div class="lifestyle-image__placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="64" height="64">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <p>Add a lifestyle photo<br>in Theme Editor</p>
        </div>
      {%- endif -%}

      <!-- Floating stitch badge -->
      <div class="lifestyle-badge" aria-hidden="true">
        <span>🧶</span>
        <div>
          <strong>Shell &amp; V-Stitch</strong>
          <small>Breathable Summer Lace</small>
        </div>
      </div>
    </div>

    <!-- Right: Story text -->
    <div class="lifestyle-content reveal reveal--delay-2">

      <p class="lifestyle-eyebrow">
        {{ section.settings.eyebrow | default: 'The Story Behind the Stitch' }}
      </p>

      <h2 id="lifestyle-heading" class="lifestyle-title">
        {{ section.settings.heading | default: 'Create Your Effortless Summer Staple' }}
      </h2>

      <p class="lifestyle-body">
        {{ section.settings.body | default: 'The Solea Cardigan was born out of a love for effortless warm-weather layering. Worked seamlessly from the top down, each row of delicate shell stitches flows naturally into the next — so you stay in a creative rhythm from start to finish.' }}
      </p>

      <!-- Checklist -->
      <ul class="lifestyle-checklist">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          {{ section.settings.check1 | default: 'Seamless top-down — no seaming ever' }}
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          {{ section.settings.check2 | default: 'Inclusive sizing: XS through 5X' }}
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          {{ section.settings.check3 | default: 'Video tutorial + written pattern + stitch chart' }}
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          {{ section.settings.check4 | default: 'Instant PDF download — yours forever' }}
        </li>
      </ul>

      <a href="#product"
         class="btn btn--primary btn--lg lifestyle-cta"
         id="lifestyle-cta-btn">
        Get the Pattern →
      </a>

    </div>

  </div>

  <!-- Wave divider into features -->
  <div class="wave-divider" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 60" preserveAspectRatio="none">
      <path fill="#FDFAF6" d="M0,20 C360,60 1080,0 1440,30 L1440,60 L0,60 Z"/>
    </svg>
  </div>

</section>

<style>
/* ---- Lifestyle Story Section ---- */
.lifestyle-section {
  position: relative;
  background: linear-gradient(160deg, #F5EFE4 0%, #EDE3D3 50%, #E5D9C5 100%);
  padding: 6rem 0 0;
  overflow: hidden;
}

.lifestyle-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 clamp(1rem, 5vw, 3rem);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
  padding-bottom: 5rem;
}

/* Image side */
.lifestyle-image {
  position: relative;
  border-radius: 32px;
  overflow: hidden;
  box-shadow: 0 24px 80px rgba(44, 36, 22, 0.22);
  aspect-ratio: 4/5;
}

.lifestyle-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.8s ease;
}

.lifestyle-image:hover img {
  transform: scale(1.03);
}

.lifestyle-image__placeholder {
  width: 100%;
  height: 100%;
  min-height: 500px;
  background: linear-gradient(145deg, rgba(196,149,106,0.15), rgba(122,158,135,0.15));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  color: rgba(61, 46, 26, 0.4);
  text-align: center;
}

.lifestyle-badge {
  position: absolute;
  bottom: 1.5rem;
  left: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: rgba(253, 250, 246, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(232, 216, 192, 0.8);
  border-radius: 9999px;
  padding: 0.6rem 1.2rem 0.6rem 0.75rem;
  box-shadow: 0 4px 24px rgba(44, 36, 22, 0.12);
}

.lifestyle-badge span {
  font-size: 1.5rem;
  line-height: 1;
}

.lifestyle-badge strong {
  display: block;
  font-size: 0.8rem;
  font-weight: 700;
  color: #2C2416;
  line-height: 1.2;
}

.lifestyle-badge small {
  font-size: 0.7rem;
  color: #7A6A55;
}

/* Content side */
.lifestyle-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.lifestyle-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #C4956A;
  margin-bottom: 0;
}

.lifestyle-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  color: #2C2416;
  line-height: 1.15;
}

.lifestyle-body {
  font-size: 1.05rem;
  line-height: 1.75;
  color: #5A4A35;
  margin: 0;
}

.lifestyle-checklist {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}

.lifestyle-checklist li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  font-size: 0.95rem;
  font-weight: 500;
  color: #3D2E1A;
  line-height: 1.5;
}

.lifestyle-checklist li svg {
  color: #7A9E87;
  flex-shrink: 0;
  margin-top: 2px;
}

.lifestyle-cta {
  align-self: flex-start;
  margin-top: 0.5rem;
}

/* Responsive */
@media (max-width: 900px) {
  .lifestyle-inner {
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .lifestyle-image {
    aspect-ratio: 3/2;
  }
}

@media (max-width: 640px) {
  .lifestyle-section {
    padding-top: 4rem;
  }
  .lifestyle-inner {
    padding-bottom: 4rem;
  }
  .lifestyle-cta {
    width: 100%;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "Lifestyle Story",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Story Behind the Stitch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create Your Effortless Summer Staple"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "The Solea Cardigan was born out of a love for effortless warm-weather layering. Worked seamlessly from the top down, each row of delicate shell stitches flows naturally into the next — so you stay in a creative rhythm from start to finish."
    },
    {
      "type": "text",
      "id": "check1",
      "label": "Checklist item 1",
      "default": "Seamless top-down — no seaming ever"
    },
    {
      "type": "text",
      "id": "check2",
      "label": "Checklist item 2",
      "default": "Inclusive sizing: XS through 5X"
    },
    {
      "type": "text",
      "id": "check3",
      "label": "Checklist item 3",
      "default": "Video tutorial + written pattern + stitch chart"
    },
    {
      "type": "text",
      "id": "check4",
      "label": "Checklist item 4",
      "default": "Instant PDF download — yours forever"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Solea Shell Stitch Cardigan worn outdoors"
    }
  ],
  "presets": [
    {
      "name": "Lifestyle Story"
    }
  ]
}
{% endschema %}
