{% comment %}
  Section: Size Guide
  Full size chart table with bust/sleeve measurements
{% endcomment %}

<section class="section section--lg" id="size-guide" style="background:var(--color-bg-alt);" aria-labelledby="size-guide-heading">
  <div class="container">

    <div class="section-title reveal">
      <p style="font-size:0.8rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-primary);margin-bottom:0.5rem;">
        📏 Measurements
      </p>
      <h2 id="size-guide-heading">{{ section.settings.heading | default: 'Size Guide' }}</h2>
      <p>{{ section.settings.subheading | default: 'All measurements are in inches. The Solea is designed with positive ease — choose your size based on your bust circumference.' }}</p>
    </div>

    <!-- Size chart -->
    <div class="reveal" style="margin-top:3rem;overflow-x:auto;">
      {% render 'size-chart-table' %}
    </div>

    <!-- Measurement tips -->
    <div class="reveal" style="margin-top:3rem;">
      <div style="background:var(--color-white);border-radius:var(--radius-xl);padding:var(--space-2xl);border:1px solid var(--color-border);">
        <h3 style="font-family:var(--font-heading);margin-bottom:1.5rem;">📌 How to Measure</h3>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-lg);">

          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <div style="font-size:1.5rem;">📏</div>
            <strong style="font-size:0.95rem;">Bust</strong>
            <p class="text-sm text-muted">Measure around the fullest part of your bust, keeping the tape parallel to the floor.</p>
          </div>

          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <div style="font-size:1.5rem;">🧶</div>
            <strong style="font-size:0.95rem;">Positive Ease</strong>
            <p class="text-sm text-muted">The Solea is designed with positive ease. Your finished bust will be larger than your actual measurement for a relaxed, breezy fit.</p>
          </div>

          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            <div style="font-size:1.5rem;">📐</div>
            <strong style="font-size:0.95rem;">Gauge</strong>
            <p class="text-sm text-muted">Always make a gauge swatch! Hook size US G/6 (4mm) with fingering #1 weight yarn. Adjust hook size as needed.</p>
          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<style>
  @media (max-width: 600px) {
    #size-guide .grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "Size Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "All measurements are in inches. The Solea is designed with positive ease — choose your size based on your bust circumference."
    }
  ],
  "presets": [
    {
      "name": "Size Guide"
    }
  ]
}
{% endschema %}
