{% comment %}
  Section: Main Cart
  Full cart page — item list, quantity controls, order summary, checkout CTA.
{% endcomment %}

{{ 'component-product.css' | asset_url | stylesheet_tag }}

<section class="cart-page" id="cart-main" aria-labelledby="cart-heading">

  <!-- Decorative blobs -->
  <div class="product-hero__bg-deco" aria-hidden="true">
    <div class="product-hero__blob product-hero__blob--1"></div>
    <div class="product-hero__blob product-hero__blob--2"></div>
  </div>

  <div class="container">

    <div class="cart-header reveal">
      <h1 id="cart-heading">Your Cart</h1>
      <a href="/" class="cart-continue-link" id="cart-continue-shopping">← Continue Shopping</a>
    </div>

    {%- if cart.item_count == 0 -%}

      <!-- Empty cart state -->
      <div class="cart-empty reveal" id="cart-empty-state">
        <div class="cart-empty__icon" aria-hidden="true">🧶</div>
        <h2>Your cart is empty</h2>
        <p>You haven't added anything yet. Go discover the Solea Cardigan Pattern!</p>
        <a href="/" class="btn btn--primary btn--lg" id="cart-empty-shop-btn">
          Shop the Pattern →
        </a>
      </div>

    {%- else -%}

      <div class="cart-layout">

        <!-- Left: Items list -->
        <div class="cart-items" aria-label="Cart items">
          {%- for item in cart.items -%}
            <div class="cart-item reveal" id="cart-item-{{ item.key | replace: ':', '-' }}">

              <!-- Product image -->
              <div class="cart-item__image">
                {%- if item.image -%}
                  <a href="{{ item.url }}">
                    {{- item.image | image_url: width: 200 | image_tag:
                        loading: 'lazy',
                        alt: item.image.alt | default: item.title -}}
                  </a>
                {%- else -%}
                  <div class="cart-item__image-placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>

              <!-- Item details -->
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item__type">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                  Digital PDF — Instant Download
                </p>

                <!-- Quantity + Remove -->
                <div class="cart-item__actions">
                  <div class="quantity-selector" data-key="{{ item.key }}">
                    <button class="quantity-selector__btn" data-action="decrement" aria-label="Decrease quantity">−</button>
                    <input class="quantity-selector__input"
                           type="number"
                           name="updates[]"
                           value="{{ item.quantity }}"
                           min="1"
                           aria-label="Quantity for {{ item.title }}">
                    <button class="quantity-selector__btn" data-action="increment" aria-label="Increase quantity">+</button>
                  </div>

                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                     class="cart-item__remove"
                     aria-label="Remove {{ item.title }} from cart"
                     id="remove-item-{{ forloop.index }}">
                    Remove
                  </a>
                </div>
              </div>

              <!-- Price -->
              <div class="cart-item__price">
                {{ item.final_line_price | money }}
              </div>

            </div>
          {%- endfor -%}
        </div>

        <!-- Right: Order summary -->
        <aside class="cart-summary reveal reveal--delay-2" aria-label="Order summary">

          <div class="cart-summary__inner">
            <h2 class="cart-summary__title">Order Summary</h2>

            <div class="cart-summary__line">
              <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <div class="cart-summary__line cart-summary__line--note">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              Taxes and discounts calculated at checkout
            </div>

            <!-- Digital download reminder -->
            <div class="cart-download-notice">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>Your PDF pattern will be available for instant download right after checkout.</span>
            </div>

            <!-- Checkout CTA -->
            <form action="{{ routes.cart_url }}" method="post">
              <button type="submit"
                      name="checkout"
                      class="btn btn--primary btn--full btn--lg"
                      id="cart-checkout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                  <line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
                Checkout Securely
              </button>
            </form>

            <!-- Trust badges -->
            <div class="cart-trust">
              <span>🔒 Secure</span>
              <span>⚡ Instant</span>
              <span>✅ 5-Star Seller</span>
            </div>

            <!-- Payment icons -->
            <p class="cart-payment-note">We accept all major credit cards, PayPal, and more.</p>

          </div>
        </aside>

      </div><!-- /cart-layout -->

    {%- endif -%}

  </div>
</section>

<style>
/* ---- Cart Page ---- */
.cart-page {
  position: relative;
  background: linear-gradient(170deg, #FDFAF6 0%, #F8F2E8 60%, #F5EFE4 100%);
  min-height: 70vh;
  padding: 5rem 0 6rem;
  overflow: hidden;
}

.cart-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.cart-header h1 {
  font-size: clamp(2rem, 4vw, 3rem);
}

.cart-continue-link {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: none;
  transition: color 0.2s;
}

.cart-continue-link:hover {
  color: var(--color-primary-dark);
}

/* Empty state */
.cart-empty {
  text-align: center;
  padding: 5rem 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}

.cart-empty__icon {
  font-size: 4rem;
  line-height: 1;
}

.cart-empty h2 {
  font-size: 1.75rem;
}

.cart-empty p {
  color: var(--color-text-muted);
  max-width: 400px;
}

/* Cart layout */
.cart-layout {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 3rem;
  align-items: start;
}

/* Cart items */
.cart-items {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.cart-item {
  display: grid;
  grid-template-columns: 100px 1fr auto;
  gap: 1.5rem;
  align-items: start;
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s;
}

.cart-item:hover {
  box-shadow: var(--shadow-md);
}

.cart-item__image {
  border-radius: var(--radius-md);
  overflow: hidden;
  aspect-ratio: 1;
  background: var(--color-bg-alt);
}

.cart-item__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-item__image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
}

.cart-item__title {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-dark);
  text-decoration: none;
  display: block;
  margin-bottom: 0.25rem;
  line-height: 1.3;
}

.cart-item__title:hover {
  color: var(--color-primary);
}

.cart-item__variant {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  margin-bottom: 0.25rem;
}

.cart-item__type {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.775rem;
  color: var(--color-accent-dark);
  font-weight: 600;
  margin-bottom: 0.875rem;
}

.cart-item__actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.cart-item__remove {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  text-decoration: underline;
  cursor: pointer;
  transition: color 0.2s;
}

.cart-item__remove:hover {
  color: var(--color-error);
}

.cart-item__price {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-dark);
  white-space: nowrap;
  text-align: right;
}

/* Cart summary */
.cart-summary {
  position: sticky;
  top: 100px;
}

.cart-summary__inner {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: 2rem;
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.cart-summary__title {
  font-size: 1.25rem;
  font-family: var(--font-heading);
  color: var(--color-dark);
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--color-border);
}

.cart-summary__line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.95rem;
  color: var(--color-text);
  font-weight: 500;
}

.cart-summary__line--note {
  font-size: 0.775rem;
  color: var(--color-text-muted);
  gap: 0.5rem;
  justify-content: flex-start;
}

.cart-download-notice {
  display: flex;
  align-items: flex-start;
  gap: 0.625rem;
  background: rgba(122, 158, 135, 0.08);
  border: 1px solid var(--color-accent-light);
  border-radius: var(--radius-md);
  padding: 0.875rem 1rem;
  font-size: 0.825rem;
  color: var(--color-accent-dark);
  font-weight: 500;
  line-height: 1.5;
}

.cart-download-notice svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  margin-top: 1px;
}

.cart-trust {
  display: flex;
  justify-content: space-around;
  gap: 0.5rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--color-bg-alt);
}

.cart-trust span {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-text-muted);
}

.cart-payment-note {
  font-size: 0.75rem;
  color: var(--color-text-muted);
  text-align: center;
  margin: 0;
}

/* Responsive */
@media (max-width: 900px) {
  .cart-layout {
    grid-template-columns: 1fr;
  }

  .cart-summary {
    position: static;
    order: -1;
  }
}

@media (max-width: 600px) {
  .cart-item {
    grid-template-columns: 80px 1fr;
    grid-template-rows: auto auto;
  }

  .cart-item__price {
    grid-column: 2;
    text-align: left;
  }
}
</style>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [{"name": "Cart"}]
}
{% endschema %}
