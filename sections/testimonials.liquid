{% comment %}
  Section: Testimonials
  Real customer reviews displayed in a masonry-style grid with pagination.
{% endcomment %}

<section class="reviews-section" id="testimonials" aria-labelledby="reviews-heading">
  <div class="container">

    <!-- Header -->
    <div class="section-title reveal">
      <p class="reviews-eyebrow">What Makers Are Saying</p>
      <h2 id="reviews-heading">Loved by Crocheters Around the World</h2>
      <div class="reviews-summary">
        <div class="reviews-stars" aria-label="Average rating 5 out of 5">
          {% for i in (1..5) %}
            <svg viewBox="0 0 24 24" fill="#F5C842" width="22" height="22" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          {% endfor %}
          <span class="reviews-summary__text"><strong>5.0</strong> · 47+ verified reviews</span>
        </div>
        <div class="reviews-badges">
          <span class="badge badge--accent">✅ 100% Recommend</span>
          <span class="badge badge--primary">🏆 Star Seller</span>
        </div>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="reviews-grid" id="reviews-grid">

      <!-- Row 1 -->
      <article class="review-card reveal reveal--delay-1">
        <div class="review-card__header">
          <div class="review-card__avatar">J</div>
          <div>
            <strong class="review-card__name">Judy</strong>
            <time class="review-card__date">Jun 5, 2026</time>
          </div>
          <div class="review-card__stars" aria-label="5 stars">★★★★★</div>
        </div>
        <p class="review-card__text">"Great pattern. Took me a minute to understand how the sleeves worked, the video was essential for that, but once I got the hang of it, it went fast and easy. Love it."</p>
        <span class="review-card__recommends">✔ Recommends</span>
      </article>

