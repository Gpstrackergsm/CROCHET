<style>
/* ---- Reviews Section ---- */
.reviews-section {
  background: linear-gradient(180deg, #FDFAF6 0%, #F0E8D8 100%);
  padding: 6rem 0;
}

.reviews-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-primary);
  margin-bottom: 0.5rem;
}

.reviews-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.875rem;
  margin-top: 1.25rem;
}

.reviews-stars {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.reviews-summary__text {
  font-size: 1rem;
  color: var(--color-text-muted);
  margin-left: 0.5rem;
}

.reviews-badges {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
}

/* Grid layout */
.reviews-grid {
  margin-top: 3rem;
  columns: 3;
  column-gap: 1.5rem;
}

.reviews-extra {
  display: contents;
}

.reviews-extra.hidden {
  display: none;
}

/* Individual review card */
.review-card {
  break-inside: avoid;
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 1.375rem;
  margin-bottom: 1.5rem;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.25s ease, transform 0.25s ease;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.review-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}

.review-card__header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.review-card__avatar {
  width: 38px;
  height: 38px;
  min-width: 38px;
  border-radius: 50%;
  background: var(--color-primary);
  color: white;
  font-weight: 700;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
}

.review-card__name {
  display: block;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--color-dark);
  line-height: 1.2;
}

.review-card__date {
  display: block;
  font-size: 0.75rem;
  color: var(--color-text-muted);
}

.review-card__stars {
  margin-left: auto;
  color: #F5C842;
  font-size: 0.85rem;
  letter-spacing: 1px;
  white-space: nowrap;
}

.review-card__text {
  font-size: 0.9rem;
  line-height: 1.65;
  color: var(--color-text);
  font-style: italic;
  margin: 0;
}

.review-card__recommends {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-accent-dark);
  display: flex;
  align-items: center;
  gap: 0.25rem;
  padding-top: 0.375rem;
  border-top: 1px solid var(--color-bg-alt);
}

/* Load more button */
.reviews-load-more {
  text-align: center;
  margin-top: 2rem;
}

/* CTA strip */
.reviews-cta-strip {
  margin-top: 4rem;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  border-radius: var(--radius-xl);
  padding: 2.5rem 2rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
}

.reviews-cta-strip p {
  color: rgba(255,255,255,0.9);
  font-size: 1.15rem;
  font-family: var(--font-heading);
  font-style: italic;
  margin: 0;
}

.reviews-cta-strip .btn--primary {
  background: white;
  color: var(--color-primary-dark);
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}

.reviews-cta-strip .btn--primary:hover {
  background: var(--color-bg);
  color: var(--color-primary-dark);
}

/* Responsive */
@media (max-width: 1024px) {
  .reviews-grid { columns: 2; }
}

@media (max-width: 640px) {
  .reviews-grid { columns: 1; }
  .reviews-cta-strip { padding: 2rem 1.25rem; }
}
</style>

<script>
(function() {
  const btn = document.getElementById('reviews-load-more-btn');
  const extra = document.getElementById('reviews-extra');
  const wrap = document.getElementById('reviews-load-more-wrap');
  if (!btn || !extra) return;

  btn.addEventListener('click', function() {
    extra.classList.remove('hidden');
    wrap.style.display = 'none';
  });
})();
</script>

{% schema %}
{
  "name": "Testimonials",
  "settings": [],
  "presets": [{"name": "Testimonials"}]
}
{% endschema %}
